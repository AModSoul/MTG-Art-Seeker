{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MTG Art Downloader",
  "version": "0.1.0",
  "identifier": "io.github.amodsoul.mtg-art-downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MTG Art Downloader",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Download Magic: The Gathering card art",
    "longDescription": "Downloads card art in bulk from MTGPics, with Scryfall as a backup, from a deck list, a Scryfall search, or an EDHREC list.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MkU4QjE3MTUzNDdDNEQKUldSTmZEUVZGNHN1T0ZGUEo4M2NBd2c2TzFqc2ZWMHFBT3RaNTlqR211aFpjdXNXNW9uNTdOVUsK",
      "endpoints": [
        "https://github.com/AModSoul/mtg-art-downloader-rust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

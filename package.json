{
  "name": "mtg-art-downloader",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm run typegen && vite",
    "build": "pnpm run typegen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "bindings": "cargo test -p mtg-art-core export_bindings && oxfmt src/bindings",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && pnpm run typegen",
    "agents:sync": "node scripts/sync-agents.ts",
    "postinstall": "pnpm run agents:sync",
    "typegen": "chakra typegen src/theme.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6008",
    "ci-storybook": "storybook dev -p 6008 --quiet --ci",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.92.0",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,yml,yaml,html,toml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.rs": "cargo fmt --"
  },
  "packageManager": "pnpm@12.18.0"
}
